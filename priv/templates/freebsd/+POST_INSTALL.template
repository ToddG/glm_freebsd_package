APP_NAME="{{ app_name }}"
PKG_USER="{{ pkg_user_name }}"
{{#if pkg_root_dir_defined }}
PKG_ROOT_DIR="{{ pkg_root_dir }}"
{{/if}}

echo "===> POST INSTALL for ${APP_NAME}"

{{# if pkg_user_uid_defined}}

if [ -n "${PKG_ROOT_DIR}" ] && [ "${PKG_ROOT_DIR}" != "/" ]; then
  echo "===> configuring '/usr/sbin/pw' to use root dir = ${PKG_ROOT_DIR}"
  PW="/usr/sbin/pw -R ${PKG_ROOT_DIR}"
else
  echo "=> using unmodified '/usr/sbin/pw'...."
  PW=/usr/sbin/pw
fi

if ! ${PW} groupshow ${PKG_USER} >/dev/null 2>&1; then
  echo "===> creating group: ${PKG_USER}"
  ${PW} groupadd ${PKG_USER} -g {{ pkg_user_uid }}
else
  echo "=> using existing group: '${PKG_USER}'."
fi

if ! ${PW} usershow ${PKG_USER} >/dev/null 2>&1; then
  echo "===> creating user: ${PKG_USER}"
  ${PW} useradd ${PKG_USER} -u {{ pkg_user_uid }} -g ${PKG_USER} -c "${APP_NAME} user" -d /nonexistent -s /usr/sbin/nologin
else
  echo "=> using existing user: '${PKG_USER}'."
fi

{{/if}}
