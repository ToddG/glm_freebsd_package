---
version: 2.0.0
title: standard_templates_/+PRE_DEINSTALL
---
APP_NAME="example"
PKG_CONFIG_DIR="/tmp/example"
PKG_USER_NAME="example"
PKG_VAR_DIR="/var/example"


echo "===> PRE DEINSTALL of ${APP_NAME}"



if [ -n "${PKG_ROOT_DIR}" ] && [ "${PKG_ROOT_DIR}" != "/" ]; then
  echo "===> configuring '/usr/sbin/pw' to use root dir = ${PKG_ROOT_DIR}"
  PW="/usr/sbin/pw -R ${PKG_ROOT_DIR}"
else
  echo "=> using unmodified '/usr/sbin/pw'...."
  PW=/usr/sbin/pw
fi

if ${PW} usershow ${PKG_USER_NAME} >/dev/null 2>&1; then
  echo "===> pkg user '${PKG_USER_NAME}' will not be automatically removed, manually remove if nec. Manual command below:"
  echo "  ${PW} userdel ${PKG_USER_NAME}"
fi

if [ -d "${PKG_CONFIG_DIR}" ]
then
  echo "===> config directory '${PKG_CONFIG_DIR}' should be manually removed. Manual command below:"
  echo "  rm -rf ${PKG_CONFIG_DIR}"
fi

if [ -d "${PKG_VAR_DIR}" ]
then
  echo "===> run directory '${PKG_VAR_DIR}' should be manually removed. Manual command below:"
  echo "  rm -rf ${PKG_VAR_DIR}"
fi



